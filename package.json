{
  "name": "caderninho",
  "version": "1.11.2",
  "description": "Um bloco de notas animado, com tarefas e lembretes.",
  "main": "main.cjs",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:app": "electron . --smoke-test",
    "package": "electron-packager . Caderninho --asar.unpack-dir=node_modules --icon=assets/icon.icns --extra-resource=assets/alarm.wav --extra-resource=native/caderninho-ocr --out=dist --overwrite --ignore='^/(tests|artifacts|\\.claude|README\\.md|generate-icon\\.cjs)'",
    "icon": "electron generate-icon.cjs",
    "prestart": "node scripts/build-ocr.cjs",
    "prepackage": "node scripts/build-ocr.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.5.1"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0"
  }
}
