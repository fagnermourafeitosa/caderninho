{
  "name": "caderninho",
  "version": "1.10.0",
  "description": "Um bloco de notas animado, com tarefas e lembretes.",
  "main": "main.cjs",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:app": "electron . --smoke-test",
